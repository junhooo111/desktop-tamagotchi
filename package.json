{
  "name": "desktop-tamagotchi",
  "version": "0.11.0",
  "description": "바탕화면에 띄워 두고 키우는 다마고치형 데스크톱 펫",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build-extension.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chrome": "npm run build && node scripts/open-chrome.mjs",
    "demo": "npm run build && node scripts/demo-server.mjs",
    "icon": "npm run build && node scripts/make-icon.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "build:extension": "node scripts/build-extension.mjs",
    "card": "npm run build && node scripts/export-card.mjs",
    "pack:mac": "npm run build && node scripts/pack-mac.mjs",
    "readme-images": "npm run build && node scripts/make-readme-images.mjs",
    "build:function": "npm run build && node scripts/build-card-function.mjs"
  },
  "build": {
    "appId": "com.desktop-tamagotchi.app",
    "productName": "Desktop Tamagotchi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "files": [
      "dist/**/*",
      "!dist/shared/art/dev-preview.js",
      "static/**/*",
      "test-pages/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Desktop Tamagotchi",
      "artifactName": "Desktop-Tamagotchi-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "junhooo111",
        "repo": "desktop-tamagotchi"
      }
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "electron-updater": "^6.8.11"
  }
}
