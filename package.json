{
  "name": "desktop-tamagotchi",
  "version": "0.1.0",
  "description": "바탕화면에 띄워 두고 키우는 다마고치형 데스크톱 펫",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
